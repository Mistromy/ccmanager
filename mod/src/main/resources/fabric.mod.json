{
  "schemaVersion": 1,
  "id": "ccmanager",
  "version": "${version}",
  "name": "CCManager",
  "description": "Debug and interaction mod for Mist's ComputerCraft Fleet Manager",
  "authors": ["Mistromy"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/ccmanager/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tech.mista.ccmanager.client.CcmanagerClient"
    ],
    "main": [
      "tech.mista.ccmanager.Ccmanager"
    ],
    "modmenu": [
      "tech.mista.ccmanager.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "ccmanager.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.6.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
